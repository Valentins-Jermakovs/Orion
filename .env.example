APP_NAME=Orion Job Aggregator
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://orion_user:change_me@postgres:5432/orion_jobs
REDIS_URL=redis://redis:6379/0

SCRAPE_API_KEY=replace_with_a_random_secret

SCRAPE_INTERVAL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGES_PER_SOURCE=5
JOB_EXPIRY_DAYS=30